package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_binary {
    name: "android.hardware.power@1.0-service.universal7580",
    defaults: ["hidl_defaults"],
    proprietary: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.power@1.0-service.universal7580.rc"],
    srcs: [
        "Power.cpp",
        "service.cpp",
    ],
    cflags: [
        "-Wall",
        "-Wextra",
        "-Werror",
        "-Wno-unused-parameter",
    ],
    shared_libs: [
        "liblog",
        "libutils",
        "libhidlbase",
        "android.hardware.power@1.0",
    ],
}
