package {
    default_applicable_licenses: ["Android-Apache-2.0"],
}

cc_defaults {
    name: "libhealth_aidl_samsung_defaults",
    shared_libs: [
        "libbase",
        "libbinder_ndk",
        "libcutils",
        "liblog",
        "libutils",
        "android.hardware.health-V4-ndk",
        "libhidlbase",
        "libpng",
    ],
    static_libs: [
        "libbatterymonitor",
        "libhealthloop",
        "android.hardware.health-translate-ndk",
        "libhealth_aidl_impl",
        "libhealthd_draw",
        "libhealthd_charger_ui",
        "libminui",
        "libsuspend",
    ],
}

// AIDL Health HAL service for Samsung/Exynos devices
cc_binary {
    name: "android.hardware.health-service.universal7580",
    relative_install_path: "hw",
    vendor: true,
    init_rc: ["android.hardware.health-service.universal7580.rc"],
    vintf_fragments: ["android.hardware.health-service.universal7580.xml"],
    defaults: ["libhealth_aidl_samsung_defaults"],
    srcs: ["main.cpp"],
    overrides: ["charger"],
}

// Recovery version
cc_binary {
    name: "android.hardware.health-service.universal7580_recovery",
    recovery: true,
    relative_install_path: "hw",
    init_rc: ["android.hardware.health-service.universal7580_recovery.rc"],
    vintf_fragments: ["android.hardware.health-service.universal7580.xml"],
    defaults: ["libhealth_aidl_samsung_defaults"],
    srcs: ["main.cpp"],
    overrides: ["charger.recovery"],
    cflags: [
        "-DCHARGER_FORCE_NO_UI=1",
    ],
    exclude_static_libs: [
        "libhealthd_draw",
        "libhealthd_charger_ui",
        "libminui",
        "libsuspend",
    ],
    exclude_shared_libs: [
        "libpng",
    ],
}
